# Angles backend env (server-only — NEVER exposed to the browser).
# Copy to .env.local for local dev, or set in the Vercel dashboard for deploys.
# Both .env and .env.local are gitignored.

# Neon Postgres connection string (from the Vercel Marketplace Neon integration).
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Secret used to HMAC-sign session cookies. Use a long, random value.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string
